# NTP服务器地址
NTP_HOST="time.google.com"

# API基本链接地址
# 开发环境指向本地 app BFF（Android 模拟器以 10.0.2.2 访问宿主机 6700 端口）。
API_BASE_URL="http://127.0.0.1:6700"
# SSE基本链接地址
SSE_URL="https://127.0.0.1:6701/events"

# 连接超时时间
CONNECTION_TIMEOUT=3000
# 接受数据等待超时时间
RECEIVE_TIMEOUT=3000

# IOS应用ID
IOS_APP_ID=

ENABLE_IN_APP_LOCALHOST_SERVER=false

# Sentry异常监控DSN
SENTRY_DSN="https://ingest.sentry.io/"

AES_KEY="f51d66a73d8a0927"
